# DigiNotice AI - Backend Environment Configuration

# Server Port (Railway automatically sets PORT dynamically)
PORT=5000

# Frontend Allowed Origin (comma-separated if multiple, *.vercel.app is allowed automatically)
FRONTEND_URL=http://localhost:5173

# Authentication Security
JWT_SECRET=super_secret_production_jwt_key_change_me_98765

# -------------------------------------------------------------
# Database Strategy 1: MySQL (Recommended on Railway)
# -------------------------------------------------------------
# Option A: Full Connection URL (automatically provided if Railway MySQL plugin added)
# MYSQL_URL=mysql://root:password@containers-us-west-123.railway.app:3306/railway

# Option B: Individual MySQL credentials (standard or Railway MYSQL* env vars)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=diginotice

# -------------------------------------------------------------
# Database Strategy 2: MongoDB (Alternative)
# -------------------------------------------------------------
# MONGO_URI=mongodb://127.0.0.1:27017/diginotice
# MONGO_URL=mongodb+srv://user:pass@cluster.mongodb.net/diginotice

# -------------------------------------------------------------
# Email Notification Configuration (Gmail / SMTP / Brevo / Mailgun)
# -------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password

# -------------------------------------------------------------
# Initial Setup & Seeding
# -------------------------------------------------------------
AUTO_SEED=true
